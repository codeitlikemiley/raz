{
	"name": "raz-vscode",
	"displayName": "RAZ - Rust Action Zapper",
	"description": "⚡ Run ANY Rust file from ANYWHERE instantly. Smart test detection, intelligent debugging with breakpoint detection. Zero config. Just hit Cmd+R and watch it fly 🚀",
	"author": "Uriah Galang <codeitlikemiley@gmail.com>",
	"icon": "images/raz-logo.gif",
	"license": "MIT",
	"version": "0.2.4",
	"repository": {
		"type": "git",
		"url": "https://github.com/codeitlikemiley/raz"
	},
	"publisher": "masterustacean",
	"galleryBanner": {
		"color": "#0a0a0a",
		"theme": "dark"
	},
	"categories": [
		"Programming Languages",
		"Other"
	],
	"keywords": [
		"rust",
		"command",
		"runner",
		"test",
		"cargo",
		"debug",
		"debugging",
		"breakpoint",
		"rust-analyzer"
	],
	"engines": {
		"vscode": "^1.89.0"
	},
	"main": "./out/extension",
	"activationEvents": [
		"onLanguage:rust"
	],
	"extensionDependencies": [
		"rust-lang.rust-analyzer",
		"vadimcn.vscode-lldb"
	],
	"contributes": {
		"commands": [
			{
				"command": "raz.runCommand",
				"title": "Run RAZ Command",
				"category": "RAZ"
			},
			{
				"command": "raz.selectAndRunCommand",
				"title": "Select and Run RAZ Command",
				"category": "RAZ"
			},
			{
				"command": "raz.runCommandWithOverride",
				"title": "Run RAZ Command with Override",
				"category": "RAZ"
			},
			{
				"command": "raz.clearOverrides",
				"title": "Clear Saved Overrides",
				"category": "RAZ"
			},
			{
				"command": "raz.listOverrides",
				"title": "List All Overrides",
				"category": "RAZ"
			},
			{
				"command": "raz.debugOverride",
				"title": "Debug Override Resolution",
				"category": "RAZ"
			},
			{
				"command": "raz.overrideStats",
				"title": "Show Project Override Statistics",
				"category": "RAZ"
			},
			{
				"command": "raz.openSettings",
				"title": "Open RAZ Settings",
				"category": "RAZ"
			},
			{
				"command": "raz.setupBinary",
				"title": "Setup RAZ Binary",
				"category": "RAZ"
			},
			{
				"command": "raz.updateBinary",
				"title": "Update RAZ Binary",
				"category": "RAZ"
			},
			{
				"command": "raz.toggleBreakpointDetection",
				"title": "Toggle Breakpoint Detection",
				"category": "RAZ"
			},
			{
				"command": "raz.showDebugInfo",
				"title": "Show Debug Info",
				"category": "RAZ"
			},
			{
				"command": "raz.resetBinary",
				"title": "Reset RAZ Binary (Clean Install)",
				"category": "RAZ"
			},
			{
				"command": "raz.init",
				"title": "Initialize RAZ Configuration",
				"category": "RAZ"
			},
			{
				"command": "raz.listOverridesForFile",
				"title": "List Overrides for Current File",
				"category": "RAZ"
			},
			{
				"command": "raz.showStatsForFile",
				"title": "Show Override Statistics for Current File",
				"category": "RAZ"
			},
			{
				"command": "raz.clearOverridesForFile",
				"title": "Clear Overrides for Current File",
				"category": "RAZ"
			},
			{
				"command": "raz.refreshOverrides",
				"title": "Refresh Overrides",
				"category": "RAZ",
				"icon": "$(refresh)"
			},
			{
				"command": "raz.editOverride",
				"title": "Edit Override",
				"category": "RAZ"
			},
			{
				"command": "raz.editAllOverrideOptions",
				"title": "Edit All Override Options",
				"category": "RAZ"
			},
			{
				"command": "raz.runSpecificOverride",
				"title": "Run Specific Override",
				"category": "RAZ"
			},
			{
				"command": "raz.debugGlobalOverrides",
				"title": "Debug Global Overrides",
				"category": "RAZ"
			},
			{
				"command": "raz.showBuildSystemInfo",
				"title": "Show Build System Info",
				"category": "RAZ",
				"icon": "$(info)"
			},
			{
				"command": "raz.generateRustProject",
				"title": "Generate rust-project.json (Bazel)",
				"category": "RAZ",
				"icon": "$(file-add)"
			},
			{
				"command": "raz.bazelSync",
				"title": "Sync Bazel Crate-Universe",
				"category": "RAZ",
				"icon": "$(sync)"
			},
			{
				"command": "raz.bazelAdd",
				"title": "Add Crate (Bazel)",
				"category": "RAZ",
				"icon": "$(package)"
			},
			{
				"command": "raz.buildSync",
				"title": "Scaffold / Update BUILD.bazel Targets",
				"category": "RAZ",
				"icon": "$(file-code)"
			},
			{
				"command": "raz.initBazel",
				"title": "Init Bazel Config (.cargo-runner.json)",
				"category": "RAZ",
				"icon": "$(gear)"
			}
		],
		"keybindings": [
			{
				"command": "raz.runCommand",
				"key": "cmd+r",
				"mac": "cmd+r",
				"when": "editorTextFocus && resourceExtname == .rs"
			},
			{
				"command": "raz.runCommandWithOverride",
				"key": "cmd+shift+r",
				"mac": "cmd+shift+r",
				"when": "editorTextFocus && resourceExtname == .rs"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "raz.refreshOverrides",
					"when": "view == razOverrides",
					"group": "navigation"
				},
				{
					"command": "raz.generateRustProject",
					"when": "view == razOverrides",
					"group": "navigation"
				},
				{
					"command": "raz.bazelSync",
					"when": "view == razOverrides",
					"group": "navigation"
				},
				{
					"command": "raz.buildSync",
					"when": "view == razOverrides",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "raz.editAllOverrideOptions",
					"when": "view == razOverrides && viewItem == razOverrideRunnable",
					"group": "navigation"
				}
			]
		},
		"views": {
			"raz": [
				{
					"id": "razOverrides",
					"name": "Overrides",
					"icon": "$(settings-gear)",
					"contextualTitle": "RAZ Overrides"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "raz",
					"title": "RAZ",
					"icon": "$(zap)"
				}
			]
		},
		"configuration": {
			"title": "RAZ",
			"properties": {
				"raz.showOutput": {
					"type": "boolean",
					"default": true,
					"description": "Show output in terminal"
				},
				"raz.useTaskRunner": {
					"type": "boolean",
					"default": true,
					"description": "Use VS Code tasks for better concurrency (allows multiple commands to run simultaneously)"
				},
				"raz.path": {
					"type": "string",
					"default": "",
					"description": "Custom path to RAZ binary. Leave empty for automatic download, or set to 'raz' to use system PATH, or provide full path to binary. Use 'RAZ: Setup RAZ Binary' command for guided setup."
				},
				"raz.enableBreakpointDetection": {
					"type": "boolean",
					"default": true,
					"description": "Enable automatic breakpoint detection for debugging integration with rust-analyzer"
				},
				"raz.enableCodeLens": {
					"type": "boolean",
					"default": true,
					"description": "Enable RAZ CodeLens above Rust functions to quickly run them"
				},
				"raz.cargoRunnerPath": {
					"type": "string",
					"default": "",
					"description": "Path to the cargo-runner binary. Leave empty to resolve from system PATH (requires `cargo install cargo-runner`)."
				},
				"raz.bazelAutoSync": {
					"type": "boolean",
					"default": true,
					"description": "When a Cargo.toml is saved inside a Bazel workspace, prompt to run `cargo runner sync` automatically."
				}
			}
		}
	},
	"dependencies": {
		"tar": "^7.4.3",
		"toml": "^3.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/node": "^20",
		"@types/tar": "^6.1.13",
		"@types/vscode": "1.89.0",
		"esbuild": "^0.25.0",
		"eslint": "^9.13.0",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.0"
	},
	"scripts": {
		"vscode:prepublish": "npm run package-ext",
		"compile": "tsc -b",
		"watch": "node esbuild.js --watch",
		"package-ext": "node esbuild.js --production",
		"lint": "eslint",
		"package": "vsce package",
		"publish": "vsce publish",
		"build": "npm run compile && npm run package-ext",
		"bundle": "npm run compile && npm run package"
	}
}
