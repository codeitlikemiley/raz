# MODULE.bazel — generated by `cargo runner init --bazel`
module(name = "complex-bazel-setup")

bazel_dep(name = "rules_rust", version = "0.63.0")

crate = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
)

crate.from_cargo(
    name = "combos_crates",
    manifests = [
    "//combos/backend:Cargo.toml",
    "//combos/frontend:Cargo.toml",
    "//combos:Cargo.toml",
    ],
    cargo_lockfile = "//combos:Cargo.lock",
)

use_repo(crate, "combos_crates")

crate.from_cargo(
    name = "corex_crates",
    manifests = [
    "//corex:Cargo.toml",
    ],
    cargo_lockfile = "//corex:Cargo.lock",
)

use_repo(crate, "corex_crates")

crate.from_cargo(
    name = "server_crates",
    manifests = [
    "//server:Cargo.toml",
    ],
    cargo_lockfile = "//server:Cargo.lock",
)

use_repo(crate, "server_crates")

